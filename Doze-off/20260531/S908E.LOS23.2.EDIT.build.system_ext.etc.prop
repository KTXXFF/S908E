ro.product.system_ext.brand=samsung
ro.product.system_ext.device=qssi
ro.product.system_ext.manufacturer=samsung
ro.product.system_ext.model=SM-S908E
ro.product.system_ext.name=b0qxxx
ro.system_ext.build.date=Sun May 31 17:51:14 UTC 2026
ro.system_ext.build.date.utc=1780249874
ro.system_ext.build.fingerprint=samsung/b0qxxx/qssi:14/UP1A.231005.007/S908EXXSCEYB1:user/release-keys
